GITHUB_TOKEN=
MONGODB_URI=
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Extra origins allowed to call this API (comma-separated), e.g. your deployed
# Vercel frontend URL. FRONTEND_URL and http://localhost:3000 are always allowed.
ALLOWED_ORIGINS=

# GitHub OAuth — enables one-click fork/branch/draft-PR from the UI.
# Create an OAuth App at https://github.com/settings/developers with
# callback URL: <this backend's URL>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/github/callback
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
